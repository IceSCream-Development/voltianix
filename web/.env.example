# ============================================================
# Voltianix - Variables de entorno del frontend (web)
# Copia este archivo a `.env` y ajusta los valores.
# Prefijo PUBLIC_ = se expone al navegador (visible en el cliente)
# ============================================================

# Fuente de datos del dashboard
#   0 = usar datos mock (locales, en src/data/mock/vehicles.ts)
#   1 = usar datos reales de Firebase (Firestore, colección "vehicles")
PUBLIC_MOCK_DATA=1

# FIREBASE
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
